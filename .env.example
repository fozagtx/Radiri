# Lending runs on the committed NEAR testnet deployment (src/config/deployment.ts):
#   lending.radiri-markets.testnet, test tokens under radiri-markets.testnet.
# These two only override it, e.g. after deploying your own copy with `pnpm deploy:testnet`.
# NEXT_PUBLIC_LENDING_CONTRACT_ID=lending.radiri-markets.testnet
# NEXT_PUBLIC_TEST_TOKEN_SUFFIX=radiri-markets.testnet
NEXT_PUBLIC_NEAR_NETWORK=testnet
# NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.fastnear.com

# Oracle reporter: function-call key limited to report_prices (written to .env.local by pnpm deploy:testnet).
# Set both on the server (e.g. Vercel) so /api/oracle/refresh can push fresh prices when they go stale.
RADIRI_ORACLE_ACCOUNT=
RADIRI_ORACLE_PRIVATE_KEY=

# Swap wallets. Injected EVM wallets work without a Reown project id; set one to enable WalletConnect.
# NEXT_PUBLIC_REOWN_PROJECT_ID=
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# NEAR Intents partner key (https://partners.near-intents.org), server-side only. Removes the 0.2% fee.
ONECLICK_JWT=

# Optional PostgreSQL index for swap history (never a source of truth for balances or debt)
# DATABASE_URL=postgresql://user:password@host:5432/radiri
