NEXT_PUBLIC_NEAR_NETWORK=testnet
# Optional override; defaults to FastNEAR public RPC for the chosen network
# NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.fastnear.com

# Lending (scripts/deploy-lending.sh prints these). Unset = the lending UI runs a labelled simulation.
NEXT_PUBLIC_LENDING_CONTRACT_ID=
# Account the test tokens live under (tpepe.<suffix>, taapl.<suffix>, ...); defaults to radiri.testnet
# NEXT_PUBLIC_TEST_TOKEN_SUFFIX=radiri.testnet

# Oracle reporter (pnpm oracle:push). Must be a function-call key limited to report_prices.
RADIRI_ORACLE_ACCOUNT=
RADIRI_ORACLE_PRIVATE_KEY=

# Swap wallets. Injected EVM wallets work without a Reown project id; set one to enable WalletConnect.
# NEXT_PUBLIC_REOWN_PROJECT_ID=
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# NEAR Intents partner keys (https://partners.near-intents.org) — server-side only, never NEXT_PUBLIC_
ONECLICK_JWT=
INTENTS_EXPLORER_JWT=

# Optional PostgreSQL index for swap history (never a source of truth for balances or debt)
# DATABASE_URL=postgresql://user:password@host:5432/radiri

# Route monitor: snapshot registry contract and its reporter (pnpm monitor)
NEXT_PUBLIC_CONTRACT_ID=radiri.testnet
RADIRI_REPORTER_ACCOUNT=
RADIRI_REPORTER_PRIVATE_KEY=

# Route monitor analyst (https://cloud.near.ai)
NEARAI_API_KEY=
# NEARAI_MODEL=google/gemini-2.5-flash
